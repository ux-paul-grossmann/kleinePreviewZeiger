{
  "manifest_version": 3,
  "name": "kleinePreviewZeiger",
  "version": "1.0",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kleinanzeigen.de/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["apple-models.json"],
      "matches": ["https://www.kleinanzeigen.de/*"]
    }
  ]
}
